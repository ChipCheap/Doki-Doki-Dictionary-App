{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "vitest/globals", "node"]
  },
  // `tools/**` is included so the pack generator is typechecked against the
  // app's own pack format. Without it the generator could drift from
  // `pack-format.ts` and only fail at install time, on a user's machine.
  "include": ["src/**/*.ts", "src/**/*.svelte", "tools/**/*.ts"]
}
