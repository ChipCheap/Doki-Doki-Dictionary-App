{
  "name": "doki-doki-dictionary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "packs:fetch": "vite-node tools/packs/main.ts -- fetch",
    "packs:build": "vite-node tools/packs/main.ts -- build",
    "packs:prune": "vite-node tools/packs/main.ts -- prune"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.2.0",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "unbzip2-stream": "^1.4.3",
    "vite": "^6.0.11",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "dexie": "^4.0.11"
  }
}
